<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.felixstieglitz.niivuejetbrains</id>
    <name>Niivue Viewer</name>
    <vendor url="https://github.com/felixstieglitz">Felix Stieglitz</vendor>
    <description><![CDATA[
        <p><b>Niivue Viewer</b> opens medical imaging volume files directly in your JetBrains IDE.</p>
        <p>Powered by <a href="https://github.com/niivue/niivue">Niivue</a> — the same WebGL2 viewer used in the standalone web app and the VSCode extension. Double-click a supported file in the Project View and it opens in an editor tab with multiplanar slices (axial, coronal, sagittal) plus a 3D render in a 2×2 grid.</p>
        <p>A toolbar lets you switch views, pan and zoom, tune the colormap and window, overlay a second volume (such as a segmentation mask or statistical map), inspect the NIfTI header, and step the crosshair or move through 4D timepoints.</p>
        <p>Useful for researchers and developers working with neuroimaging or other 3D volume data — particularly when you already use Python tooling (nibabel, dipy, ANTs, FSL, nilearn) and want to inspect a volume without leaving the IDE.</p>
        <p><b>Supported formats:</b> NIfTI (<code>.nii</code>, <code>.nii.gz</code>), NRRD (<code>.nrrd</code>, <code>.nhdr</code>), FreeSurfer (<code>.mgh</code>, <code>.mgz</code>), MetaImage (<code>.mha</code>), MRtrix (<code>.mif</code>, <code>.mif.gz</code>, <code>.mih</code>), BrainVoyager (<code>.v16</code>, <code>.vmr</code>), NumPy (<code>.npy</code>, <code>.npz</code>).</p>
    ]]></description>

    <!-- change-notes are generated from CHANGELOG.md by the changelog Gradle
         plugin (see build.gradle.kts, patchPluginXml's changeNotes provider).
         Do not add a static block here — it would override the generated one. -->

    <depends>com.intellij.modules.platform</depends>

    <!-- Up to 2026.1 the JCEF classes were part of the platform core, so every
         plugin saw com.intellij.ui.jcef.* and org.cef.* for free. In 2026.2
         (build 262) they moved into the bundled "Web Browser (JCEF)" plugin,
         whose classes sit in content modules; a plugin that does not depend on
         them dies with NoClassDefFoundError: com/intellij/ui/jcef/JBCefApp when
         an editor is created. Both modules are needed: intellij.platform.ui.jcef
         holds JBCefApp/JBCefBrowser/JBCefJSQuery, intellij.libraries.jcef holds
         the org.cef.* handler classes. This is the same set the platform's own
         JCEF-based plugins (Images, Markdown, Mermaid) declare.
         The explicit sinceBuild in build.gradle.kts keeps this release on 262+
         even when the development platform is upgraded later. -->
    <dependencies>
        <plugin id="com.intellij.modules.jcef"/>
        <module name="intellij.libraries.jcef"/>
        <module name="intellij.platform.ui.jcef"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <fileType name="NIfTI"
                  implementationClass="com.github.felixstieglitz.niivuejetbrains.filetype.NiftiFileType"
                  fieldName="INSTANCE"
                  extensions="nii;nrrd;nhdr;mgh;mgz;mha;mif;mih;v16;vmr;npy;npz"
                  patterns="*.nii.gz;*.mif.gz"/>
        <fileEditorProvider implementation="com.github.felixstieglitz.niivuejetbrains.editor.NiivueFileEditorProvider"/>
    </extensions>
</idea-plugin>
